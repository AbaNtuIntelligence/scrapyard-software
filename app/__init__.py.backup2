@app.route('/api/materials', methods=['GET'])
@login_required
def api_get_materials():
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute('SELECT * FROM materials ORDER BY code')
    materials = cursor.fetchall()
    conn.close()
    return jsonify([dict(m) for m in materials])

@app.route('/api/materials', methods=['POST'])
@admin_required
def api_create_material():
    data = request.json
    conn = get_db()
    cursor = conn.cursor()
    try:
        cursor.execute('''
            INSERT INTO materials (code, name, inbound_price, outbound_price, description, is_active)
            VALUES (?, ?, ?, ?, ?, ?)
        ''', (data['code'], data['name'], data['inbound_price'], data['outbound_price'], 
              data.get('description', ''), data.get('is_active', 1)))
        conn.commit()
        return jsonify({'success': True, 'id': cursor.lastrowid})
    except sqlite3.IntegrityError:
        return jsonify({'error': 'Material code or name already exists'}), 400
    finally:
        conn.close()

@app.route('/api/materials/<int:material_id>', methods=['PUT'])
@admin_required
def api_update_material(material_id):
    data = request.json
    conn = get_db()
    cursor = conn.cursor()
    try:
        cursor.execute('''
            UPDATE materials 
            SET code = ?, name = ?, inbound_price = ?, outbound_price = ?, 
                description = ?, is_active = ?
            WHERE id = ?
        ''', (data['code'], data['name'], data['inbound_price'], data['outbound_price'],
              data.get('description', ''), data.get('is_active', 1), material_id))
        conn.commit()
        return jsonify({'success': True})
    except sqlite3.IntegrityError:
        return jsonify({'error': 'Material code or name already exists'}), 400
    finally:
        conn.close()

@app.route('/api/materials/<int:material_id>', methods=['DELETE'])
@admin_required
def api_delete_material(material_id):
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute('SELECT COUNT(*) FROM transactions WHERE material_id = ?', (material_id,))
    count = cursor.fetchone()[0]
    if count > 0:
        cursor.execute('UPDATE materials SET is_active = 0 WHERE id = ?', (material_id,))
        conn.commit()
        conn.close()
        return jsonify({'success': True, 'soft_delete': True, 'message': f'Material has {count} transactions, marked as inactive'})
    else:
        cursor.execute('DELETE FROM materials WHERE id = ?', (material_id,))
        conn.commit()
        conn.close()
        return jsonify({'success': True, 'soft_delete': False})
    
