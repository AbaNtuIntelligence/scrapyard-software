# ============ REPORT FUNCTIONS ============
def calculate_start_date(date_range, end_date):
    if date_range == 'today':
        return end_date.replace(hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'yesterday':
        return (end_date - timedelta(days=1)).replace(hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'week':
        return end_date - timedelta(days=end_date.weekday())
    elif date_range == 'month':
        return end_date.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'quarter':
        quarter_month = ((end_date.month - 1) // 3) * 3 + 1
        return end_date.replace(month=quarter_month, day=1, hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'year':
        return end_date.replace(month=1, day=1, hour=0, minute=0, second=0, microsecond=0)
    else:
        return end_date - timedelta(days=30)

def generate_inbound_report(cursor, start_date, end_date):
    cursor.execute('''
        SELECT m.code, m.name, 
               COALESCE(SUM(t.weight_kg), 0) as total_weight,
               COALESCE(SUM(t.amount), 0) as total_amount,
               COUNT(t.id) as transaction_count,
               CASE WHEN SUM(t.weight_kg) > 0 THEN ROUND(SUM(t.amount) / SUM(t.weight_kg), 2) ELSE 0 END as avg_price
        FROM materials m
        LEFT JOIN transactions t ON m.id = t.material_id 
            AND t.direction = 'inbound'
            AND DATE(t.timestamp) BETWEEN DATE(?) AND DATE(?)
        GROUP BY m.id, m.code, m.name
        ORDER BY total_weight DESC
    ''', (start_date, end_date))
    items = [dict(row) for row in cursor.fetchall()]
    total_weight = sum(i['total_weight'] for i in items)
    total_amount = sum(i['total_amount'] for i in items)
    return {
        'items': items, 'total_weight': total_weight, 'total_amount': total_amount,
        'transaction_count': sum(i['transaction_count'] for i in items),
        'avg_price': total_amount / total_weight if total_weight > 0 else 0
    }

def generate_seller_report(cursor, start_date, end_date):
    cursor.execute('''
        SELECT s.full_name, s.id_number,
               COALESCE(SUM(t.weight_kg), 0) as total_weight,
               COALESCE(SUM(t.amount), 0) as total_amount,
               COUNT(t.id) as transaction_count,
               MIN(t.timestamp) as first_transaction,
               MAX(t.timestamp) as last_transaction
        FROM sellers s
        LEFT JOIN transactions t ON s.id = t.seller_id 
            AND DATE(t.timestamp) BETWEEN DATE(?) AND DATE(?)
        GROUP BY s.id, s.full_name, s.id_number
        ORDER BY total_amount DESC
    ''', (start_date, end_date))
    sellers = [dict(row) for row in cursor.fetchall()]
    total_weight = sum(s['total_weight'] for s in sellers)
    total_amount = sum(s['total_amount'] for s in sellers)
    return {
        'sellers': sellers, 'total_weight': total_weight, 'total_amount': total_amount,
        'transaction_count': sum(s['transaction_count'] for s in sellers),
        'avg_price': total_amount / total_weight if total_weight > 0 else 0
    }

# ============ REPORT ROUTES ============
@app.route('/api/reports/generate', methods=['GET'])
@login_required
def api_generate_report():
    report_type = request.args.get('report_type', 'inbound')
    date_range = request.args.get('date_range', 'month')
    start_date_str = request.args.get('start_date', '')
    end_date_str = request.args.get('end_date', '')
    
    # Admin check for outbound reports
    if report_type == 'outbound' and not session.get('is_admin', False):
        return jsonify({'success': False, 'error': 'Admin access required for outbound reports'}), 403
    
    # Rest of your report generation code...
    # (Keep your existing report generation logic)
    
    end_date = datetime.now()
    start_date = calculate_start_date(date_range, end_date)
    
    if date_range == 'custom' and start_date_str and end_date_str:
        try:
            start_date = datetime.strptime(start_date_str, '%Y-%m-%d')
            end_date = datetime.strptime(end_date_str, '%Y-%m-%d')
        except ValueError:
            return jsonify({'success': False, 'error': 'Invalid date format'}), 400
    
    conn = get_db()
    cursor = conn.cursor()
    
    if report_type == 'inbound':
        result = generate_inbound_report(cursor, start_date, end_date)
    elif report_type == 'seller':
        result = generate_seller_report(cursor, start_date, end_date)
    else:
        result = {'items': [], 'total_weight': 0, 'total_amount': 0, 'transaction_count': 0, 'avg_price': 0}
    
    conn.close()
    result.update({
        'success': True,
        'report_type': report_type,
        'period': f'{start_date.strftime("%Y-%m-%d")} to {end_date.strftime("%Y-%m-%d")}'
    })
    return jsonify(result)

