# ============ HELPER FUNCTIONS ============
def get_mock_weight():
    return round(random.uniform(0.5, 100.0), 2)

def get_current_weight(scale_id='scale_1'):
    return round(random.uniform(0.5, 100.0), 2)

# ============ DATABASE FUNCTIONS ============
def get_db():
    if os.environ.get('RENDER'):
        db_path = '/tmp/scrapyard.db'
    else:
        db_path = 'scrapyard.db'
    conn = sqlite3.connect(db_path)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = get_db()
    cursor = conn.cursor()
    
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS materials (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            code TEXT UNIQUE NOT NULL,
            name TEXT UNIQUE NOT NULL,
            inbound_price REAL,
            outbound_price REAL,
            description TEXT,
            is_active BOOLEAN DEFAULT 1
        )
    ''')
    
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS sellers (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            full_name TEXT NOT NULL,
            id_number TEXT UNIQUE NOT NULL,
            phone TEXT,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS transactions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ticket_number TEXT UNIQUE NOT NULL,
            seller_id INTEGER NOT NULL,
            material_id INTEGER NOT NULL,
            material_code TEXT NOT NULL,
            weight_kg REAL NOT NULL,
            amount REAL NOT NULL,
            scale_id TEXT,
            direction TEXT,
            reference_number TEXT,
            timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (seller_id) REFERENCES sellers (id),
            FOREIGN KEY (material_id) REFERENCES materials (id)
        )
    ''')
    
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS scale_config (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            scale_id TEXT UNIQUE NOT NULL,
            name TEXT NOT NULL,
            location TEXT,
            capacity_kg INTEGER,
            is_active BOOLEAN DEFAULT 1,
            display_order INTEGER DEFAULT 0,
            last_calibration DATE
        )
    ''')
    
    cursor.execute('SELECT COUNT(*) FROM scale_config')
    if cursor.fetchone()[0] == 0:
        scales = [
            ('scale_1', 'Main Gate Scale', 'Main Entrance', 5000, 1),
            ('scale_2', 'Secondary Scale', 'South Gate', 3000, 2),
            ('scale_3', 'Processing Scale', 'Sorting Area', 1000, 3),
            ('scale_4', 'Weighbridge Scale', 'Weighbridge', 20000, 4)
        ]
        cursor.executemany('''
            INSERT INTO scale_config (scale_id, name, location, capacity_kg, display_order)
            VALUES (?, ?, ?, ?, ?)
        ''', scales)
    
    cursor.execute('SELECT COUNT(*) FROM materials')
    if cursor.fetchone()[0] == 0:
        materials = [
            ('K4', 'Cardboard', 1.50, 0.80, 'Corrugated cardboard boxes'),
            ('AL1', 'Aluminium Cans', 25.00, 18.00, 'Clean aluminium beverage cans'),
            ('CU1', 'Copper', 120.00, 90.00, 'Clean copper wire'),
        ]
        cursor.executemany('''
            INSERT INTO materials (code, name, inbound_price, outbound_price, description)
            VALUES (?, ?, ?, ?, ?)
        ''', materials)
    
    conn.commit()
    conn.close()

init_db()







@app.route('/api/reports/generate', methods=['GET'])
def api_generate_report():
    """Generate various reports based on parameters"""
    report_type = request.args.get('report_type', 'inbound')
    date_range = request.args.get('date_range', 'month')
    start_date_str = request.args.get('start_date', '')
    end_date_str = request.args.get('end_date', '')
    
    # Check permission for outbound reports
    if report_type == 'outbound' and not session.get('is_admin', False):
        return jsonify({'success': False, 'error': 'Admin access required for outbound reports'}), 403
    
    # Calculate date range
    end_date = datetime.now()
    start_date = calculate_start_date(date_range, end_date)
    
    if date_range == 'custom' and start_date_str and end_date_str:
        try:
            start_date = datetime.strptime(start_date_str, '%Y-%m-%d')
            end_date = datetime.strptime(end_date_str, '%Y-%m-%d')
            # Set end_date to end of day
            end_date = end_date.replace(hour=23, minute=59, second=59)
        except ValueError:
            return jsonify({'success': False, 'error': 'Invalid date format'}), 400
    
    conn = get_db()
    cursor = conn.cursor()
    
    if report_type == 'inbound':
        result = generate_inbound_report(cursor, start_date, end_date)
    elif report_type == 'outbound':
        result = generate_outbound_report(cursor, start_date, end_date)
    elif report_type == 'inventory':
        result = generate_inventory_report(cursor, start_date, end_date)
    elif report_type == 'seller':
        result = generate_seller_report(cursor, start_date, end_date)
    elif report_type == 'scale':
        result = generate_scale_report(cursor, start_date, end_date)
    elif report_type == 'comparison':
        result = generate_comparison_report(cursor, start_date, end_date)
    else:
        return jsonify({'success': False, 'error': 'Invalid report type'}), 400
    
    conn.close()
    return jsonify(result)

def calculate_start_date(date_range, end_date):
    """Calculate start date based on range type"""
    if date_range == 'today':
        return end_date.replace(hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'yesterday':
        return (end_date - timedelta(days=1)).replace(hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'week':
        # Start of current week (Monday)
        start = end_date - timedelta(days=end_date.weekday())
        return start.replace(hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'month':
        return end_date.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'quarter':
        quarter_month = ((end_date.month - 1) // 3) * 3 + 1
        return end_date.replace(month=quarter_month, day=1, hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'year':
        return end_date.replace(month=1, day=1, hour=0, minute=0, second=0, microsecond=0)
    else:
        return end_date - timedelta(days=30)

def generate_inbound_report(cursor, start_date, end_date):
    """Generate inbound (purchase) report"""
    cursor.execute('''
        SELECT 
            m.code, 
            m.name, 
            COALESCE(SUM(t.weight_kg), 0) as total_weight,
            COALESCE(SUM(t.amount), 0) as total_amount,
            COUNT(t.id) as transaction_count,
            CASE 
                WHEN SUM(t.weight_kg) > 0 
                THEN ROUND(SUM(t.amount) / SUM(t.weight_kg), 2)
                ELSE 0 
            END as avg_price
        FROM materials m
        LEFT JOIN transactions t ON m.id = t.material_id 
            AND t.direction = 'inbound'
            AND t.timestamp BETWEEN ? AND ?
        GROUP BY m.id, m.code, m.name
        HAVING total_weight > 0 OR total_amount > 0
        ORDER BY total_weight DESC
    ''', (start_date, end_date))
    
    items = [dict(row) for row in cursor.fetchall()]
    
    total_weight = sum(i['total_weight'] for i in items)
    total_amount = sum(i['total_amount'] for i in items)
    
    return {
        'success': True,
        'report_type': 'inbound',
        'period': f'{start_date.strftime("%Y-%m-%d")} to {end_date.strftime("%Y-%m-%d")}',
        'items': items,
        'total_weight': total_weight,
        'total_amount': total_amount,
        'transaction_count': sum(i['transaction_count'] for i in items),
        'avg_price': total_amount / total_weight if total_weight > 0 else 0
    }

def generate_outbound_report(cursor, start_date, end_date):
    """Generate outbound (sale) report"""
    cursor.execute('''
        SELECT 
            m.code, 
            m.name, 
            COALESCE(SUM(t.weight_kg), 0) as total_weight,
            COALESCE(SUM(t.amount), 0) as total_amount,
            COUNT(t.id) as transaction_count,
            CASE 
                WHEN SUM(t.weight_kg) > 0 
                THEN ROUND(SUM(t.amount) / SUM(t.weight_kg), 2)
                ELSE 0 
            END as avg_price
        FROM materials m
        LEFT JOIN transactions t ON m.id = t.material_id 
            AND t.direction = 'outbound'
            AND t.timestamp BETWEEN ? AND ?
        GROUP BY m.id, m.code, m.name
        HAVING total_weight > 0 OR total_amount > 0
        ORDER BY total_weight DESC
    ''', (start_date, end_date))
    
    items = [dict(row) for row in cursor.fetchall()]
    
    total_weight = sum(i['total_weight'] for i in items)
    total_amount = sum(i['total_amount'] for i in items)
    
    return {
        'success': True,
        'report_type': 'outbound',
        'period': f'{start_date.strftime("%Y-%m-%d")} to {end_date.strftime("%Y-%m-%d")}',
        'items': items,
        'total_weight': total_weight,
        'total_amount': total_amount,
        'transaction_count': sum(i['transaction_count'] for i in items),
        'avg_price': total_amount / total_weight if total_weight > 0 else 0
    }

def generate_seller_report(cursor, start_date, end_date):
    """Generate seller performance report"""
    cursor.execute('''
        SELECT 
            s.full_name, 
            s.id_number,
            s.phone,
            COALESCE(SUM(t.weight_kg), 0) as total_weight,
            COALESCE(SUM(t.amount), 0) as total_amount,
            COUNT(t.id) as transaction_count,
            MIN(t.timestamp) as first_transaction,
            MAX(t.timestamp) as last_transaction
        FROM sellers s
        LEFT JOIN transactions t ON s.id = t.seller_id 
            AND t.timestamp BETWEEN ? AND ?
        GROUP BY s.id, s.full_name, s.id_number, s.phone
        HAVING total_weight > 0 OR total_amount > 0
        ORDER BY total_amount DESC
    ''', (start_date, end_date))
    
    sellers = []
    for row in cursor.fetchall():
        seller = dict(row)
        seller['first_transaction'] = seller['first_transaction'][:10] if seller['first_transaction'] else '-'
        seller['last_transaction'] = seller['last_transaction'][:10] if seller['last_transaction'] else '-'
        sellers.append(seller)
    
    total_weight = sum(s['total_weight'] for s in sellers)
    total_amount = sum(s['total_amount'] for s in sellers)
    
    return {
        'success': True,
        'report_type': 'seller',
        'period': f'{start_date.strftime("%Y-%m-%d")} to {end_date.strftime("%Y-%m-%d")}',
        'sellers': sellers,
        'total_weight': total_weight,
        'total_amount': total_amount,
        'transaction_count': sum(s['transaction_count'] for s in sellers),
        'avg_price': total_amount / total_weight if total_weight > 0 else 0
    }

def generate_scale_report(cursor, start_date, end_date):
    """Generate scale usage report"""
    cursor.execute('''
        SELECT 
            sc.name, 
            sc.location,
            COUNT(t.id) as transaction_count,
            COALESCE(SUM(t.weight_kg), 0) as total_weight,
            COALESCE(SUM(t.amount), 0) as total_amount
        FROM scale_config sc
        LEFT JOIN transactions t ON sc.scale_id = t.scale_id 
            AND t.timestamp BETWEEN ? AND ?
        GROUP BY sc.scale_id, sc.name, sc.location
        ORDER BY transaction_count DESC
    ''', (start_date, end_date))
    
    scales = [dict(row) for row in cursor.fetchall()]
    
    return {
        'success': True,
        'report_type': 'scale',
        'period': f'{start_date.strftime("%Y-%m-%d")} to {end_date.strftime("%Y-%m-%d")}',
        'scales': scales
    }

def generate_inventory_report(cursor, start_date, end_date):
    """Generate inventory valuation report"""
    cursor.execute('''
        SELECT 
            m.code, 
            m.name,
            COALESCE(SUM(CASE WHEN t.direction = 'inbound' THEN t.weight_kg ELSE 0 END), 0) as inbound_total,
            COALESCE(SUM(CASE WHEN t.direction = 'outbound' THEN t.weight_kg ELSE 0 END), 0) as outbound_total,
            COALESCE(MAX(CASE WHEN t.direction = 'inbound' THEN t.amount / t.weight_kg ELSE NULL END), 0) as avg_price
        FROM materials m
        LEFT JOIN transactions t ON m.id = t.material_id 
            AND t.timestamp BETWEEN ? AND ?
        GROUP BY m.id, m.code, m.name
    ''', (start_date, end_date))
    
    inventory = []
    for row in cursor.fetchall():
        item = dict(row)
        net_change = item['inbound_total'] - item['outbound_total']
        current_value = net_change * item['avg_price'] if net_change > 0 else 0
        item['net_change'] = net_change
        item['current_value'] = current_value
        inventory.append(item)
    
    return {
        'success': True,
        'report_type': 'inventory',
        'period': f'{start_date.strftime("%Y-%m-%d")} to {end_date.strftime("%Y-%m-%d")}',
        'inventory': inventory
    }

def generate_comparison_report(cursor, start_date, end_date):
    """Generate period comparison report"""
    # Calculate previous period of same length
    period_length = (end_date - start_date).days
    previous_end = start_date - timedelta(days=1)
    previous_start = previous_end - timedelta(days=period_length)
    
    def get_period_stats(cursor, s_date, e_date, direction='inbound'):
        cursor.execute('''
            SELECT 
                COALESCE(SUM(weight_kg), 0) as total_weight,
                COALESCE(SUM(amount), 0) as total_amount,
                COUNT(id) as transaction_count
            FROM transactions
            WHERE direction = ?
                AND timestamp BETWEEN ? AND ?
        ''', (direction, s_date, e_date))
        stats = cursor.fetchone()
        return dict(stats)
    
    current = get_period_stats(cursor, start_date, end_date, 'inbound')
    previous = get_period_stats(cursor, previous_start, previous_end, 'inbound')
    
    # Calculate average price
    current['avg_price'] = current['total_amount'] / current['total_weight'] if current['total_weight'] > 0 else 0
    previous['avg_price'] = previous['total_amount'] / previous['total_weight'] if previous['total_weight'] > 0 else 0
    
    return {
        'success': True,
        'report_type': 'comparison',
        'period': f'{start_date.strftime("%Y-%m-%d")} to {end_date.strftime("%Y-%m-%d")}',
        'current': current,
        'previous': previous
    }
# ============ REPORT FUNCTIONS ============
def calculate_start_date(date_range, end_date):
    if date_range == 'today':
        return end_date.replace(hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'yesterday':
        return (end_date - timedelta(days=1)).replace(hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'week':
        return end_date - timedelta(days=end_date.weekday())
    elif date_range == 'month':
        return end_date.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'quarter':
        quarter_month = ((end_date.month - 1) // 3) * 3 + 1
        return end_date.replace(month=quarter_month, day=1, hour=0, minute=0, second=0, microsecond=0)
    elif date_range == 'year':
        return end_date.replace(month=1, day=1, hour=0, minute=0, second=0, microsecond=0)
    else:
        return end_date - timedelta(days=30)

def generate_inbound_report(cursor, start_date, end_date):
    cursor.execute('''
        SELECT m.code, m.name, 
               COALESCE(SUM(t.weight_kg), 0) as total_weight,
               COALESCE(SUM(t.amount), 0) as total_amount,
               COUNT(t.id) as transaction_count,
               CASE WHEN SUM(t.weight_kg) > 0 THEN ROUND(SUM(t.amount) / SUM(t.weight_kg), 2) ELSE 0 END as avg_price
        FROM materials m
        LEFT JOIN transactions t ON m.id = t.material_id 
            AND t.direction = 'inbound'
            AND DATE(t.timestamp) BETWEEN DATE(?) AND DATE(?)
        GROUP BY m.id, m.code, m.name
        ORDER BY total_weight DESC
    ''', (start_date, end_date))
    items = [dict(row) for row in cursor.fetchall()]
    total_weight = sum(i['total_weight'] for i in items)
    total_amount = sum(i['total_amount'] for i in items)
    return {
        'items': items, 'total_weight': total_weight, 'total_amount': total_amount,
        'transaction_count': sum(i['transaction_count'] for i in items),
        'avg_price': total_amount / total_weight if total_weight > 0 else 0
    }

def generate_outbound_report(cursor, start_date, end_date):
    cursor.execute('''
        SELECT m.code, m.name, 
               COALESCE(SUM(t.weight_kg), 0) as total_weight,
               COALESCE(SUM(t.amount), 0) as total_amount,
               COUNT(t.id) as transaction_count,
               CASE WHEN SUM(t.weight_kg) > 0 THEN ROUND(SUM(t.amount) / SUM(t.weight_kg), 2) ELSE 0 END as avg_price
        FROM materials m
        LEFT JOIN transactions t ON m.id = t.material_id 
            AND t.direction = 'outbound'
            AND DATE(t.timestamp) BETWEEN DATE(?) AND DATE(?)
        GROUP BY m.id, m.code, m.name
        ORDER BY total_weight DESC
    ''', (start_date, end_date))
    items = [dict(row) for row in cursor.fetchall()]
    total_weight = sum(i['total_weight'] for i in items)
    total_amount = sum(i['total_amount'] for i in items)
    return {
        'items': items, 'total_weight': total_weight, 'total_amount': total_amount,
        'transaction_count': sum(i['transaction_count'] for i in items),
        'avg_price': total_amount / total_weight if total_weight > 0 else 0
    }

def generate_seller_report(cursor, start_date, end_date):
    cursor.execute('''
        SELECT s.full_name, s.id_number, s.phone,
               COALESCE(SUM(t.weight_kg), 0) as total_weight,
               COALESCE(SUM(t.amount), 0) as total_amount,
               COUNT(t.id) as transaction_count,
               MIN(t.timestamp) as first_transaction,
               MAX(t.timestamp) as last_transaction
        FROM sellers s
        LEFT JOIN transactions t ON s.id = t.seller_id 
            AND DATE(t.timestamp) BETWEEN DATE(?) AND DATE(?)
        GROUP BY s.id, s.full_name, s.id_number, s.phone
        ORDER BY total_amount DESC
    ''', (start_date, end_date))
    sellers = []
    for row in cursor.fetchall():
        seller = dict(row)
        seller['first_transaction'] = seller['first_transaction'][:10] if seller['first_transaction'] else '-'
        seller['last_transaction'] = seller['last_transaction'][:10] if seller['last_transaction'] else '-'
        sellers.append(seller)
    total_weight = sum(s['total_weight'] for s in sellers)
    total_amount = sum(s['total_amount'] for s in sellers)
    return {
        'sellers': sellers, 'total_weight': total_weight, 'total_amount': total_amount,
        'transaction_count': sum(s['transaction_count'] for s in sellers),
        'avg_price': total_amount / total_weight if total_weight > 0 else 0
    }

def generate_scale_report(cursor, start_date, end_date):
    cursor.execute('''
        SELECT sc.name, sc.location,
               COUNT(t.id) as transaction_count,
               COALESCE(SUM(t.weight_kg), 0) as total_weight,
               COALESCE(SUM(t.amount), 0) as total_amount
        FROM scale_config sc
        LEFT JOIN transactions t ON sc.scale_id = t.scale_id 
            AND DATE(t.timestamp) BETWEEN DATE(?) AND DATE(?)
        GROUP BY sc.scale_id, sc.name, sc.location
        ORDER BY transaction_count DESC
    ''', (start_date, end_date))
    scales = [dict(row) for row in cursor.fetchall()]
    return {'scales': scales}

def generate_inventory_report(cursor, start_date, end_date):
    cursor.execute('''
        SELECT m.code, m.name,
               COALESCE(SUM(CASE WHEN t.direction = 'inbound' THEN t.weight_kg ELSE 0 END), 0) as inbound_total,
               COALESCE(SUM(CASE WHEN t.direction = 'outbound' THEN t.weight_kg ELSE 0 END), 0) as outbound_total,
               COALESCE(AVG(CASE WHEN t.direction = 'inbound' THEN t.amount / t.weight_kg ELSE NULL END), 0) as avg_price
        FROM materials m
        LEFT JOIN transactions t ON m.id = t.material_id 
            AND DATE(t.timestamp) BETWEEN DATE(?) AND DATE(?)
        GROUP BY m.id, m.code, m.name
    ''', (start_date, end_date))
    inventory = []
    for row in cursor.fetchall():
        item = dict(row)
        net_change = item['inbound_total'] - item['outbound_total']
        item['net_change'] = net_change
        item['current_value'] = net_change * item['avg_price'] if net_change > 0 else 0
        inventory.append(item)
    return {'inventory': inventory}

def generate_comparison_report(cursor, start_date, end_date):
    period_length = (end_date - start_date).days
    previous_end = start_date - timedelta(days=1)
    previous_start = previous_end - timedelta(days=period_length)
    
    def get_stats(s_date, e_date):
        cursor.execute('''
            SELECT COALESCE(SUM(weight_kg), 0) as total_weight,
                   COALESCE(SUM(amount), 0) as total_amount,
                   COUNT(id) as transaction_count
            FROM transactions
            WHERE direction = 'inbound' AND DATE(timestamp) BETWEEN DATE(?) AND DATE(?)
        ''', (s_date, e_date))
        stats = cursor.fetchone()
        return {
            'total_weight': stats[0], 'total_amount': stats[1], 'transaction_count': stats[2],
            'avg_price': stats[1] / stats[0] if stats[0] > 0 else 0
        }
    
    return {'current': get_stats(start_date, end_date), 'previous': get_stats(previous_start, previous_end)}

# ============ REPORT API ROUTE ============
@app.route('/api/reports/generate', methods=['GET'])
def api_generate_report():
    report_type = request.args.get('report_type', 'inbound')
    date_range = request.args.get('date_range', 'month')
    start_date_str = request.args.get('start_date', '')
    end_date_str = request.args.get('end_date', '')
    
    if report_type == 'outbound' and not session.get('is_admin', False):
        return jsonify({'success': False, 'error': 'Admin access required'}), 403
    
    end_date = datetime.now()
    start_date = calculate_start_date(date_range, end_date)
    
    if date_range == 'custom' and start_date_str and end_date_str:
        try:
            start_date = datetime.strptime(start_date_str, '%Y-%m-%d')
            end_date = datetime.strptime(end_date_str, '%Y-%m-%d')
        except ValueError:
            return jsonify({'success': False, 'error': 'Invalid date format'}), 400
    
    conn = get_db()
    cursor = conn.cursor()
    
    if report_type == 'inbound':
        result = generate_inbound_report(cursor, start_date, end_date)
    elif report_type == 'outbound':
        result = generate_outbound_report(cursor, start_date, end_date)
    elif report_type == 'seller':
        result = generate_seller_report(cursor, start_date, end_date)
    elif report_type == 'scale':
        result = generate_scale_report(cursor, start_date, end_date)
    elif report_type == 'inventory':
        result = generate_inventory_report(cursor, start_date, end_date)
    elif report_type == 'comparison':
        result = generate_comparison_report(cursor, start_date, end_date)
    else:
        return jsonify({'success': False, 'error': 'Invalid report type'}), 400
    
    conn.close()
    result.update({
        'success': True,
        'report_type': report_type,
        'period': f'{start_date.strftime("%Y-%m-%d")} to {end_date.strftime("%Y-%m-%d")}'
    })
    return jsonify(result)
